<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
  <persistence-unit name="birdy" transaction-type="JTA">
    <jta-data-source>java:app/jdbc/birdy</jta-data-source>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    <!-- No second-level cache: the database is the only truth for sessions (expiry, logout, cascading deletes). -->
    <shared-cache-mode>NONE</shared-cache-mode>
    <properties>
      <!-- The schema is owned by db/schema.sql, applied by SchemaInitializer; the provider never creates or alters tables. -->
      <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
    </properties>
  </persistence-unit>
</persistence>
