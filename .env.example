# Copy to .env and change the passwords. Compose reads this file; nothing here is used in production as is.
BIRDY_PORT=8080

MYSQL_DATABASE=birdy
MYSQL_USER=birdy
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

MONGO_DATABASE=birdy
MONGO_USER=birdy
MONGO_PASSWORD=change-me
# MONGO_IMAGE=mongo:7.0.45   # only on hosts whose kernel MongoDB 8 rejects, such as Ubuntu 26.04

BIRDY_SESSION_TTL_HOURS=168
