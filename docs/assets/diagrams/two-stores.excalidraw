   "link": null,
   "locked": false,
   "strokeSharpness": "sharp",
   "text": "Why here: accounts, sessions and follows are relations.\nMySQL refuses a duplicate username and removes the\nsessions and follows of a deleted user by itself.",
   "originalText": "Why here: accounts, sessions and follows are relations.\nMySQL refuses a duplicate username and removes the\nsessions and follows of a deleted user by itself.",
