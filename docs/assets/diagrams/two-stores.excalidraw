   "updated": 1,
   "link": null,
   "locked": false,
   "strokeSharpness": "sharp",
   "text": "Every authorId and every entry of likes is a users.id. No foreign\nkey crosses the two stores: the backend keeps them in step.",
   "originalText": "Every authorId and every entry of likes is a users.id. No foreign\nkey crosses the two stores: the backend keeps them in step.",
